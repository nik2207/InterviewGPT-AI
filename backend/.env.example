MONGODB_URL=
DATABASE_NAME=interviewgpt
# Comma-separated if you have multiple frontends (local + production)
CORS_ORIGIN=http://localhost:3000,https://your-frontend.up.railway.app

GOOGLE_CLIENT_ID=
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=120
GEMINI_SDK_HTTP_ATTEMPTS=4
GEMINI_APP_RETRY_ATTEMPTS=1
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1.0
GEMINI_RETRY_MAX_DELAY_SECONDS=8.0

# Optional path to a Unicode TTF font used for multilingual PDF exports.
PDF_UNICODE_FONT_PATH=
